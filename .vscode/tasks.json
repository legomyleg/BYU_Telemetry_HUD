{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build HUD",
      "type": "shell",
      "command": "clang++",
      "args": [
        "hud.cpp",
        "-std=c++17",
        "-I/opt/homebrew/include",
        "-L/opt/homebrew/lib",
        "-o",
        "hud",
        "-lraylib",
        "-framework",
        "OpenGL",
        "-framework",
        "Cocoa",
        "-framework",
        "IOKit",
        "-framework",
        "CoreVideo"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
